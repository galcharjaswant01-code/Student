services:
  # The main Django ASGI server
  - type: web
    name: student-management-backend
    env: python
    rootDir: backend
    buildCommand: "./build.sh"
    # Use daphne or uvicorn for ASGI. We'll use uvicorn with standard workers for Channels support.
    startCommand: "uvicorn config.asgi:application --host 0.0.0.0 --port $PORT"
    envVars:
      - key: DJANGO_SETTINGS_MODULE
        value: "config.settings.prod"
      - key: PYTHON_VERSION
        value: "3.12.0"
      - key: DATABASE_URL
        fromDatabase:
          name: student-management-db
          property: connectionString
      - key: REDIS_URL
        fromService:
          type: redis
          name: student-management-redis
          property: connectionString
      - key: SECRET_KEY
        generateValue: true
      - key: CORS_ALLOWED_ORIGINS
        sync: false
      - key: DEBUG
        value: "False"
      - key: TENCENT_IM_SDK_APP_ID
        sync: false
      - key: TENCENT_IM_ADMIN_IDENTIFIER
        sync: false
      - key: TENCENT_IM_USER_SIG
        sync: false

  # Celery Worker for background tasks
  - type: worker
    name: student-management-celery-worker
    env: python
    rootDir: backend
    buildCommand: "pip install -r requirements.txt"
    startCommand: "celery -A config worker -l INFO"
    envVars:
      - key: DJANGO_SETTINGS_MODULE
        value: "config.settings.prod"
      - key: PYTHON_VERSION
        value: "3.12.0"
      - key: DATABASE_URL
        fromDatabase:
          name: student-management-db
          property: connectionString
      - key: REDIS_URL
        fromService:
          type: redis
          name: student-management-redis
          property: connectionString
      - key: SECRET_KEY
        generateValue: true
      - key: DEBUG
        value: "False"

  # Celery Beat for scheduled tasks
  - type: worker
    name: student-management-celery-beat
    env: python
    rootDir: backend
    buildCommand: "pip install -r requirements.txt"
    startCommand: "celery -A config beat -l INFO"
    envVars:
      - key: DJANGO_SETTINGS_MODULE
        value: "config.settings.prod"
      - key: PYTHON_VERSION
        value: "3.12.0"
      - key: DATABASE_URL
        fromDatabase:
          name: student-management-db
          property: connectionString
      - key: REDIS_URL
        fromService:
          type: redis
          name: student-management-redis
          property: connectionString
      - key: SECRET_KEY
        generateValue: true
      - key: DEBUG
        value: "False"

databases:
  - name: student-management-db
    plan: free
    databaseName: student_management
    user: student_admin

  # Render recently added managed Redis support
  - name: student-management-redis
    type: redis
    plan: free
